@startuml
start
:Пользователь вводит поисковый запрос;
if (Запрос пустой?) then (да)
  :Показать сообщение «Введите запрос»;
  stop
else (нет)
  :Применить фильтры (дата, тип, сущности);
  :Выполнить полнотекстовый поиск по индексу;
  :Выполнить поиск по извлечённым сущностям;
  :Объединить и ранжировать результаты;
  if (Результаты найдены?) then (нет)
    :Показать «Ничего не найдено»;
  else (да)
    :Отобразить список результатов с сниппетами;
    :Пользователь выбирает документ;
    :Показать документ с подсветкой совпадений;
  endif
endif
stop
@enduml