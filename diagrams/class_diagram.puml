@startuml
skinparam classAttributeIconSize 0

enum Role {
  ADMIN
  ANALYST
  USER
}

enum DocumentStatus {
  UPLOADED
  DEPERSONALIZING
  DEPERSONALIZED
  EXTRACTING
  EXTRACTED
  STRUCTURING
  STRUCTURED
  INDEXING
  INDEXED
  FAILED
}

class User {
  - id: int
  - login: string
  - passwordHash: string
  - fullName: string
  - email: string
  - role: Role
  + login()
  + logout()
  + hasPermission(permission: string): bool
}

class Document {
  - id: int
  - title: string
  - originalFileName: string
  - filePath: string
  - mimeType: string
  - size: long
  - uploadDate: Date
  - status: DocumentStatus
  - textContent: string
  - depersonalized: bool
  + upload()
  + depersonalize()
  + extractText()
  + structure()
  + index()
  + getEntities(): List<ExtractedEntity>
}

class DepersonalizationRule {
  - id: int
  - name: string
  - pattern: string
  - replacement: string
  - type: string
  - active: bool
  + apply(text: string): string
}

class ExtractedEntity {
  - id: int
  - type: string
  - value: string
  - confidence: double
  - startPos: int
  - endPos: int
  + getType(): string
  + getValue(): string
}

class ProcessingTask {
  - id: int
  - type: string
  - status: string
  - startedAt: Date
  - finishedAt: Date
  - errorMessage: string
  + execute()
  + cancel()
}

class SearchQuery {
  - id: int
  - queryText: string
  - filters: string
  - createdAt: Date
  + execute(): List<SearchResult>
}

class SearchResult {
  - score: double
  - snippet: string
  + getDocument(): Document
  + getScore(): double
}

User "1" -- "0..*" Document : загружает >
User "1" -- "0..*" SearchQuery : выполняет >
Document "1" -- "0..*" ExtractedEntity : содержит >
Document "1" -- "0..*" ProcessingTask : имеет >
Document "1" -- "0..*" DepersonalizationRule : применяет >
SearchQuery "1" -- "0..*" SearchResult : возвращает >
SearchResult "*" -- "1" Document : ссылается >
@enduml