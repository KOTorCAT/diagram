@startuml
actor Analyst
participant "UI" as UI
participant "DocumentController" as DC
participant "DocumentService" as DS
participant "DepersonalizationService" as DPS
participant "OCRService" as OCR
participant "StructuringService" as SS
participant "IndexService" as IS
participant "DocumentRepository" as DR
database "DB" as DB

Analyst -> UI : выбрать файл и нажать «Загрузить»
UI -> DC : uploadDocument(file, metadata)
DC -> DS : createDocument(file)
DS -> DR : save(Document status=UPLOADED)
DR -> DB : INSERT document
DB --> DR : id
DR --> DS : document
DS -> DPS : depersonalize(document)
DPS -> DPS : applyRules(text)
DPS --> DS : depersonalizedText
DS -> OCR : extractText(file)
OCR --> DS : text
DS -> SS : structure(text)
SS --> DS : entities, metadata
DS -> IS : index(document, text, entities)
IS --> DS : success
DS -> DR : update(status=INDEXED)
DR -> DB : UPDATE document
DS --> DC : result
DC --> UI : success
UI --> Analyst : статус «Готов к поиску»
@enduml